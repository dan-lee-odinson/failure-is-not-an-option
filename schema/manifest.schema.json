{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fno.local/schema/manifest.schema.json",
  "title": "Asset manifest",
  "type": "object",
  "required": ["content_version", "manifest_version", "task", "status", "assets"],
  "properties": {
    "content_version": { "$ref": "defs.schema.json#/$defs/semver" },
    "manifest_version": { "type": "string" },
    "task": { "type": "string" },
    "status": { "type": "string" },
    "notes": { "type": "string" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/imageAsset" },
          { "$ref": "#/$defs/audioAsset" },
          { "$ref": "#/$defs/videoAsset" }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "imageAsset": {
      "type": "object",
      "required": ["id", "filename", "width", "height", "alpha", "color_space", "framing", "reference_version", "origin", "attribution", "status"],
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "filename": { "type": "string", "anyOf": [
          { "pattern": "^fno_[a-z0-9]+_[a-z0-9]+_[a-z0-9-]+_[a-z0-9]+_v[0-9]{3}\\.png$" },
          { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-v[0-9]{3}\\.svg$" }
        ] },
        "format": { "enum": ["png", "svg"] },
        "kind": { "enum": ["room", "portrait", "emblem", "layer", "image"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "alpha": { "type": "boolean" },
        "color_space": { "const": "sRGB" },
        "framing": { "type": "string" },
        "reference_version": { "type": "string" },
        "origin": { "type": "string" },
        "attribution": { "type": "string" },
        "status": { "enum": ["to-generate", "placeholder", "final"] }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "type": "object", "properties": { "filename": { "type": "string", "pattern": "\\.svg$" } } }, "then": { "type": "object", "required": ["format"], "properties": { "format": { "const": "svg" }, "alpha": { "const": true } } } },
        { "if": { "type": "object", "required": ["format"], "properties": { "format": { "const": "svg" } } }, "then": { "type": "object", "properties": { "filename": { "type": "string", "pattern": "\\.svg$" } } } }
      ]
    },
    "audioAsset": {
      "type": "object",
      "description": "A sound the app may play. Files live under public/audio/ (the filename may carry the soundscape-cc0/ or generated/ subfolder); a missing file plays silence and is listed by npm run placeholders. Credit and rights lines are shown in About/Credits.",
      "required": ["id", "filename", "kind", "format", "title", "credit", "rights", "license", "duration_s", "origin", "attribution", "status"],
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "filename": { "type": "string", "pattern": "^(soundscape-cc0/|generated/)?[A-Za-z0-9 ()_.-]+\\.(mp3|wav)$" },
        "kind": { "const": "audio" },
        "format": { "enum": ["mp3", "wav"] },
        "title": { "type": "string", "minLength": 1 },
        "credit": { "type": "string", "minLength": 1 },
        "rights": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string" },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "origin": { "type": "string" },
        "attribution": { "type": "string" },
        "status": { "enum": ["to-generate", "placeholder", "final"] }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "type": "object", "properties": { "filename": { "type": "string", "pattern": "\\.mp3$" } } }, "then": { "type": "object", "properties": { "format": { "const": "mp3" } } } },
        { "if": { "type": "object", "properties": { "filename": { "type": "string", "pattern": "\\.wav$" } } }, "then": { "type": "object", "properties": { "format": { "const": "wav" } } } }
      ]
    },
    "videoAsset": {
      "type": "object",
      "description": "A video the app may play (the opening film's deployed cut, FNO-DEPLOY). Files live under public/video/ and are served as plain files; the player skips to the den when the file fails to load or play. Credit and rights lines are shown in About/Credits.",
      "required": ["id", "filename", "kind", "format", "width", "height", "duration_s", "title", "credit", "rights", "license", "sha256", "origin", "attribution", "status"],
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "filename": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.(mp4|webm)$" },
        "kind": { "const": "video" },
        "format": { "enum": ["mp4", "webm"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "credit": { "type": "string", "minLength": 1 },
        "rights": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "origin": { "type": "string" },
        "attribution": { "type": "string" },
        "status": { "enum": ["to-generate", "placeholder", "final"] }
      },
      "additionalProperties": false
    }
  }
}
