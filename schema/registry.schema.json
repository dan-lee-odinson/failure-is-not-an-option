{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fno.local/schema/registry.schema.json",
  "title": "Sources, fiction register, labels and notices",
  "type": "object",
  "required": [
    "content_version",
    "labels",
    "notices",
    "sources",
    "fiction"
  ],
  "properties": {
    "content_version": {
      "$ref": "defs.schema.json#/$defs/semver"
    },
    "labels": {
      "type": "object",
      "required": [
        "start_notice",
        "alternate_history_badge",
        "alternate_history_explanation",
        "simulated_report",
        "postflight_header"
      ],
      "properties": {
        "start_notice": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "alternate_history_badge": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "alternate_history_explanation": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "simulated_report": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "postflight_header": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "historical_choice_badge": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "departures_heading": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "capcom_history_note": {
          "$ref": "defs.schema.json#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "notices": {
      "type": "object",
      "required": [
        "dedication",
        "project_disclaimer",
        "ai_disclosure",
        "dramatization"
      ],
      "properties": {
        "dedication": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/text"
          }
        },
        "project_disclaimer": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "ai_disclosure": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "dramatization": {
          "$ref": "defs.schema.json#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^H[0-9]+$"
          },
          "title": {
            "$ref": "defs.schema.json#/$defs/text"
          },
          "author": {
            "$ref": "defs.schema.json#/$defs/text"
          },
          "url": {
            "$ref": "defs.schema.json#/$defs/url"
          },
          "note": {
            "$ref": "defs.schema.json#/$defs/text"
          }
        },
        "additionalProperties": false
      }
    },
    "fiction": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          },
          "title": {
            "$ref": "defs.schema.json#/$defs/text"
          },
          "text": {
            "$ref": "defs.schema.json#/$defs/text"
          }
        },
        "additionalProperties": false
      }
    },
    "credits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "lines"
        ],
        "properties": {
          "heading": {
            "$ref": "defs.schema.json#/$defs/text"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "defs.schema.json#/$defs/text"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "opening_den": {
      "type": "object",
      "required": [
        "background",
        "projection_rect",
        "smoke",
        "smoke_loop",
        "beam",
        "note"
      ],
      "properties": {
        "background": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "projection_rect": {
          "type": "object",
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "smoke": {
          "$ref": "mission.schema.json#/$defs/moving_element"
        },
        "smoke_loop": {
          "type": "object",
          "required": [
            "seconds",
            "crossfade_seconds"
          ],
          "properties": {
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "crossfade_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "beam": {
          "type": "object",
          "required": [
            "asset",
            "placement"
          ],
          "properties": {
            "asset": {
              "$ref": "defs.schema.json#/$defs/id"
            },
            "placement": {
              "$ref": "mission.schema.json#/$defs/moving_element/properties/placement"
            }
          },
          "additionalProperties": false
        },
        "note": {
          "$ref": "defs.schema.json#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "required": [
        "blocks"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "id",
              "items"
            ],
            "properties": {
              "id": {
                "enum": [
                  "hero",
                  "about",
                  "demo",
                  "gallery",
                  "coming_soon",
                  "bio",
                  "notices",
                  "nasa_marks",
                  "open_source",
                  "footer"
                ]
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "kind"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "kind": {
                      "enum": [
                        "metadata",
                        "heading",
                        "paragraph",
                        "link",
                        "button",
                        "label",
                        "alt",
                        "aria",
                        "tooltip",
                        "notice",
                        "template"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "notice_id": {
                      "enum": [
                        "dedication",
                        "project_disclaimer",
                        "ai_disclosure",
                        "dramatization"
                      ]
                    },
                    "href": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(https://|\\./|#)\\S+$"
                    }
                  },
                  "oneOf": [
                    {
                      "properties": {
                        "text": {}
                      },
                      "required": [
                        "text"
                      ]
                    },
                    {
                      "properties": {
                        "notice_id": {}
                      },
                      "required": [
                        "notice_id"
                      ]
                    }
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
