{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fno.local/schema/mission.schema.json",
  "title": "Mission",
  "type": "object",
  "required": [
    "content_version",
    "id",
    "title",
    "chapter",
    "dramatization",
    "anchors",
    "start_notice",
    "seed_people",
    "finish",
    "phases",
    "outcomes",
    "debrief",
    "debrief_layout"
  ],
  "properties": {
    "content_version": {
      "$ref": "defs.schema.json#/$defs/semver"
    },
    "id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "title": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "subtitle": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "chapter": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "dramatization": {
      "const": true
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "$ref": "defs.schema.json#/$defs/text"
          },
          "url": {
            "$ref": "defs.schema.json#/$defs/url"
          }
        },
        "additionalProperties": false
      }
    },
    "start_notice": {
      "$ref": "defs.schema.json#/$defs/text"
    },
    "seed_people": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "finish": {
      "type": "object",
      "required": [
        "id",
        "requires"
      ],
      "properties": {
        "id": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "requires": {
          "$ref": "defs.schema.json#/$defs/condition"
        }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "debrief": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/debrief_rule"
      }
    },
    "debrief_layout": {
      "type": "object",
      "required": [
        "consequence_node",
        "relationship_node",
        "accountability_node",
        "controllers",
        "astronauts",
        "constraint_facts"
      ],
      "properties": {
        "consequence_node": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "relationship_node": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "accountability_node": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "controllers": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/id"
          }
        },
        "astronauts": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/id"
          }
        },
        "constraint_facts": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/id"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "prologue": {
      "type": "object",
      "properties": {
        "plates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/prologue_plate"
          }
        },
        "scenario_card": {
          "$ref": "#/$defs/scenario_card"
        },
        "history_note": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "history_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^H[0-9]+$"
          }
        },
        "interpretation": {
          "$ref": "defs.schema.json#/$defs/text"
        }
      },
      "required": [
        "plates",
        "scenario_card",
        "history_note",
        "history_sources",
        "interpretation"
      ],
      "additionalProperties": false
    },
    "resolution_presentation": {
      "type": "object",
      "properties": {
        "heading": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "relationships_heading": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "trust_up": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "trust_down": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "enum": [
                  "SUCCESS",
                  "MIXED",
                  "COSTLY",
                  "FAILURE",
                  "LOSS"
                ]
              },
              "meaning": {
                "$ref": "defs.schema.json#/$defs/text"
              }
            },
            "required": [
              "id",
              "meaning"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "heading",
        "relationships_heading",
        "trust_up",
        "trust_down",
        "tiers"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "phase": {
      "type": "object",
      "required": [
        "id",
        "title",
        "display_time",
        "contact",
        "attention",
        "nodes"
      ],
      "properties": {
        "id": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "title": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "display_time": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "contact": {
          "enum": [
            "houston",
            "tracking-ship",
            "none",
            "not-in-flight"
          ]
        },
        "attention": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "alternate_history": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "defs.schema.json#/$defs/condition"
            }
          ],
          "default": false,
          "description": "Presentation marker: absent or false does not activate it. True or a condition that becomes active after this phase is entered persists for the rest of the run, even if the condition later becomes false. Derived from recorded run history; no domain-state effect."
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "additionalProperties": false
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/briefing"
        },
        {
          "$ref": "#/$defs/prep_choice"
        },
        {
          "$ref": "#/$defs/decision"
        },
        {
          "$ref": "#/$defs/event"
        }
      ]
    },
    "briefing": {
      "type": "object",
      "required": [
        "type",
        "id",
        "continue"
      ],
      "properties": {
        "type": {
          "const": "briefing"
        },
        "id": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "title": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "header_label": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "text": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/conditional_text"
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/document"
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/line"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/question"
          }
        },
        "continue": {
          "$ref": "defs.schema.json#/$defs/continue"
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "defs.schema.json#/$defs/id"
              },
              "label": {
                "$ref": "defs.schema.json#/$defs/text"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "prep_choice": {
      "type": "object",
      "required": [
        "type",
        "id",
        "prompt",
        "cost",
        "options",
        "reasons",
        "finish"
      ],
      "properties": {
        "type": {
          "const": "prep_choice"
        },
        "id": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "prompt": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "text": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "cost": {
          "type": "integer",
          "minimum": 1
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "defs.schema.json#/$defs/option"
          }
        },
        "reasons": {
          "type": "object",
          "required": [
            "completed",
            "exhausted"
          ],
          "properties": {
            "completed": {
              "$ref": "defs.schema.json#/$defs/text"
            },
            "exhausted": {
              "$ref": "defs.schema.json#/$defs/text"
            }
          },
          "additionalProperties": false
        },
        "finish": {
          "$ref": "defs.schema.json#/$defs/continue"
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "type",
        "id",
        "prompt",
        "options"
      ],
      "properties": {
        "type": {
          "const": "decision"
        },
        "id": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "title": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "header_label": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "prompt": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "text": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/document"
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/line"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/question"
          }
        },
        "readout": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "fact",
              "ready",
              "not_ready"
            ],
            "properties": {
              "label": {
                "$ref": "defs.schema.json#/$defs/text"
              },
              "fact": {
                "$ref": "defs.schema.json#/$defs/id"
              },
              "ready": {
                "$ref": "defs.schema.json#/$defs/text"
              },
              "not_ready": {
                "$ref": "defs.schema.json#/$defs/text"
              }
            },
            "additionalProperties": false
          }
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "defs.schema.json#/$defs/option"
          }
        },
        "hint": {
          "$ref": "defs.schema.json#/$defs/text",
          "description": "Presentation only: a procedural hint shown above the cards after 30 s of idling when hints are on. Never a recommendation between options; never read by the engine. Added in FNO-M00c for content 0.5.2."
        },
        "historical_option": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "defs.schema.json#/$defs/id"
              },
              "label": {
                "$ref": "defs.schema.json#/$defs/text"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "type",
        "id",
        "resolutions",
        "continue"
      ],
      "properties": {
        "type": {
          "const": "event"
        },
        "id": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "title": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "label": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "resolutions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resolution"
          }
        },
        "continue": {
          "$ref": "defs.schema.json#/$defs/continue"
        }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": [
        "id",
        "when",
        "effects"
      ],
      "properties": {
        "id": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "when": {
          "$ref": "defs.schema.json#/$defs/condition"
        },
        "effects": {
          "$ref": "defs.schema.json#/$defs/effects"
        },
        "sub_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "when",
              "effects"
            ],
            "properties": {
              "when": {
                "$ref": "defs.schema.json#/$defs/condition"
              },
              "effects": {
                "$ref": "defs.schema.json#/$defs/effects"
              }
            },
            "additionalProperties": false
          }
        },
        "finally": {
          "$ref": "defs.schema.json#/$defs/effects"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/line"
          }
        },
        "text": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "status": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/text"
          }
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "requires"
      ],
      "properties": {
        "id": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "title": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "kind": {
          "enum": [
            "success",
            "partial",
            "abort-safe",
            "loss"
          ]
        },
        "requires": {
          "$ref": "defs.schema.json#/$defs/condition"
        },
        "tier": {
          "enum": [
            "SUCCESS",
            "MIXED",
            "COSTLY",
            "FAILURE",
            "LOSS"
          ]
        },
        "result_line": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "plate": {
          "$ref": "defs.schema.json#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "debrief_rule": {
      "type": "object",
      "required": [
        "id",
        "when",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "when": {
          "$ref": "defs.schema.json#/$defs/condition"
        },
        "text": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "section": {
          "enum": [
            "departures"
          ]
        },
        "provenance": {
          "$ref": "defs.schema.json#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "moving_element": {
      "type": "object",
      "properties": {
        "asset": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "placement": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height",
            "opacity"
          ],
          "additionalProperties": false
        },
        "motion": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "drift",
                "rise",
                "pan"
              ]
            },
            "direction": {
              "enum": [
                "left",
                "right",
                "up",
                "down"
              ]
            },
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "from": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            "to": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "direction",
            "seconds",
            "from",
            "to"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "asset",
        "placement",
        "motion"
      ],
      "additionalProperties": false
    },
    "prologue_plate": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "title": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "background": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "moving_element": {
          "$ref": "#/$defs/moving_element"
        },
        "caption": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^H[0-9]+$"
          }
        }
      },
      "required": [
        "id",
        "title",
        "background",
        "moving_element",
        "caption",
        "sources"
      ],
      "additionalProperties": false
    },
    "scenario_card": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "background": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "facility": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "date": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "mission": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "scenario": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "context": {
          "$ref": "defs.schema.json#/$defs/text"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^H[0-9]+$"
          }
        },
        "moving_element": {
          "$ref": "#/$defs/moving_element"
        }
      },
      "required": [
        "id",
        "background",
        "facility",
        "date",
        "mission",
        "scenario",
        "context",
        "sources",
        "moving_element"
      ],
      "additionalProperties": false
    }
  }
}
